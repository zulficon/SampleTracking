@{
    ViewData["Title"] = "Numune Yönetimi";
}

<main class="app-shell">
    <section id="login-view" class="login-view">
        <div class="login-panel">
            <div class="login-brand-wrap">
                <div class="login-brand">
                    <span class="brand-symbol">NA</span>
                    <div>
                        <strong>Numune Analiz Takip</strong>
                        <small>Laboratuvar operasyon sistemi</small>
                    </div>
                </div>
                <button id="login-theme-toggle" class="theme-toggle-pill" type="button" aria-label="Temayı değiştir" title="Temayı değiştir">
                    <span class="theme-sun">☀️</span>
                    <span class="theme-moon">🌙</span>
                </button>
            </div>

            <div class="login-copy">
                <span class="eyebrow">GÜVENLİ OTURUM</span>
                <h1>Çalışma alanına giriş yap</h1>
                <p>Numune süreçlerini, durum geçmişini ve laboratuvar akışını tek yerden yönet.</p>
            </div>

            <form id="login-form" class="login-form">
                <label for="username">Kullanıcı adı</label>
                <input id="username" name="username" autocomplete="username" placeholder="Kullanıcı adın" required />

                <label for="password">Parola</label>
                <input id="password" name="password" type="password" autocomplete="current-password" placeholder="Parolan" required />

                <button class="button button-primary button-full" type="submit">Giriş yap</button>
            </form>
            <p id="login-message" class="form-message" aria-live="polite"></p>
            <div class="login-register">
                <span>Henüz hesabın yok mu?</span>
                <button id="show-register" class="text-button" type="button">Hesap oluştur</button>
                <small>Yeni hesaplar yönetici onayından sonra kullanılabilir.</small>
            </div>
        </div>

        <aside class="login-visual" aria-hidden="true">
            <div class="visual-orbit orbit-one"></div>
            <div class="visual-orbit orbit-two"></div>
            <div class="visual-content">
                <span>NUMUNE YAŞAM DÖNGÜSÜ</span>
                <strong>Kayıttan analize kadar<br />her adım görünür.</strong>
                <div class="visual-flow">
                    <i></i><i></i><i></i><i></i><i></i><i></i>
                </div>
            </div>
        </aside>
    </section>

    <section id="dashboard-view" class="dashboard-view" hidden>
        <aside class="sidebar">
            <div class="sidebar-brand">
                <span class="brand-symbol compact">NA</span>
                <div>
                    <strong>Numune Takip</strong>
                    <small>Operasyon paneli</small>
                </div>
                <button id="command-palette-trigger" class="sidebar-search-pill" type="button" aria-label="Hızlı komut paletini aç" title="Hızlı komut paleti (Ctrl + K)">
                    <span class="search-icon" aria-hidden="true">⌕</span>
                    <span class="search-placeholder">Hızlı ara veya komut gir...</span>
                    <kbd class="kbd-badge">Ctrl K</kbd>
                </button>
            </div>

            <nav class="sidebar-nav" aria-label="Ana menü">
                <span class="nav-group-label">GENEL</span>
                <button id="nav-overview" class="nav-item active" data-view-target="overview-view" type="button">
                    <span class="nav-icon">⌂</span>
                    <span><strong>Genel bakış</strong><small>Operasyon özeti</small></span>
                </button>

                <span class="nav-group-label">OPERASYON</span>
                <button id="nav-samples" class="nav-item" data-view-target="samples-view" type="button">
                    <span class="nav-icon">N</span>
                    <span><strong>Numuneler</strong><small>Kayıtları yönet</small></span>
                </button>
                <button id="nav-analysis-catalog" class="nav-item" data-view-target="analysis-catalog-view" type="button">
                    <span class="nav-icon">A</span>
                    <span><strong>Analiz kataloğu</strong><small>Kodlar ve parametreler</small></span>
                </button>
                <button id="nav-performance" class="nav-item" data-view-target="performance-view" type="button">
                    <span class="nav-icon">P</span>
                    <span><strong>Performans analizi</strong><small>İş yükü & verimlilik</small></span>
                </button>

                <span id="management-nav-label" class="nav-group-label">YÖNETİM</span>
                <button id="nav-users" class="nav-item" data-view-target="users-view" type="button" hidden>
                    <span class="nav-icon">K</span>
                    <span><strong>Kullanıcılar</strong><small>Hesapları yönet</small></span>
                </button>
                <button id="nav-knowledge-base" class="nav-item" data-view-target="knowledge-base-view" type="button" hidden>
                    <span class="nav-icon">R</span>
                    <span><strong>Bilgi havuzu</strong><small>RAG belgeleri ve arama</small></span>
                </button>

            </nav>

            <section class="sidebar-session" aria-label="Hesap işlemleri">
                <div class="sidebar-user-row">
                    <button id="nav-profile" class="session-profile-compact" data-view-target="profile-view" type="button" title="Profilimi düzenle">
                        <span class="user-avatar" id="session-avatar">U</span>
                        <span class="session-profile-copy">
                            <strong id="session-user"></strong>
                            <small id="session-role"></small>
                        </span>
                    </button>
                    <button id="theme-toggle-btn" class="sidebar-theme-icon-btn" type="button" aria-label="Temayı değiştir" title="Temayı değiştir">
                        <span class="theme-sun">☀️</span>
                        <span class="theme-moon">🌙</span>
                    </button>
                </div>
                <button id="logout-button" class="sidebar-logout-button" type="button">
                    <span>Çıkış yap</span>
                    <span aria-hidden="true">↗</span>
                </button>
            </section>
        </aside>

        <section class="workspace">
            <header class="workspace-header">
                <div>
                    <span id="page-eyebrow" class="eyebrow">OPERASYON MERKEZİ</span>
                    <h1 id="page-title">Genel bakış</h1>
                    <p id="page-description">Numune akışının güncel durumunu tek ekranda takip et.</p>
                </div>
            </header>

            <section id="overview-view" class="app-view">
                <div class="overview-grid">
                    <article class="operations-summary">
                        <div class="summary-heading">
                            <div>
                                <span class="eyebrow light">CANLI OPERASYON</span>
                                <h2>Numune portföyü</h2>
                            </div>
                            <span class="live-indicator"><i></i> Güncel</span>
                        </div>

                        <div class="total-metric">
                            <strong id="stat-total">0</strong>
                            <span>toplam numune</span>
                        </div>

                        <div class="metric-strip">
                            <div><span>Aktif süreç</span><strong id="stat-active">0</strong></div>
                            <div><span>Analizde</span><strong id="stat-analyzing">0</strong></div>
                            <div><span>Tamamlandı</span><strong id="stat-completed">0</strong></div>
                        </div>
                    </article>

                    <article class="completion-panel">
                        <div>
                            <span class="eyebrow">VERİMLİLİK</span>
                            <h2>Tamamlanma oranı</h2>
                            <p>Toplam numunelerin tamamlanan kısmı.</p>
                        </div>
                        <div id="completion-ring" class="completion-ring" style="--completion: 0">
                            <div><strong id="completion-rate">0%</strong><span>tamamlandı</span></div>
                        </div>
                    </article>
                </div>

                <article class="panel workflow-panel">
                    <div class="panel-header">
                        <div>
                            <span class="eyebrow">İŞ AKIŞI</span>
                            <h2>Numune süreç dağılımı</h2>
                            <p>Her aşamada bekleyen güncel numune sayısı.</p>
                        </div>
                    </div>
                    <div class="workflow-stages">
                        <div class="workflow-stage stage-created"><span class="stage-number">01</span><strong id="stage-created">0</strong><b>Kayıt açıldı</b><small>Sisteme eklendi</small></div>
                        <div class="workflow-stage stage-collected"><span class="stage-number">02</span><strong id="stage-collected">0</strong><b>Toplandı</b><small>Saha işlemi</small></div>
                        <div class="workflow-stage stage-transferred"><span class="stage-number">03</span><strong id="stage-transferred">0</strong><b>Transferde</b><small>Sevkiyat süreci</small></div>
                        <div class="workflow-stage stage-received"><span class="stage-number">04</span><strong id="stage-received">0</strong><b>Kabul edildi</b><small>Laboratuvara ulaştı</small></div>
                        <div class="workflow-stage stage-analyzing"><span class="stage-number">05</span><strong id="stage-analyzing">0</strong><b>Analizde</b><small>Aktif inceleme</small></div>
                        <div class="workflow-stage stage-completed"><span class="stage-number">06</span><strong id="stage-completed">0</strong><b>Tamamlandı</b><small>Süreç sonucu</small></div>
                    </div>
                </article>

                <article class="panel recent-panel">
                    <div class="panel-header inline">
                        <div>
                            <span class="eyebrow">SON HAREKETLER</span>
                            <h2>Yeni eklenen numuneler</h2>
                        </div>
                        <button id="overview-show-all" class="text-button" type="button">Tüm numuneleri gör →</button>
                    </div>
                    <div class="table-wrap">
                        <table>
                            <thead><tr><th>Numune</th><th>Tür</th><th>Konum</th><th>Durum</th><th>Güncellendi</th><th></th></tr></thead>
                            <tbody id="recent-sample-table"></tbody>
                        </table>
                    </div>
                </article>
            </section>

            <section id="samples-view" class="app-view" hidden>
                <article class="panel samples-panel">
                    <div class="panel-header inline samples-heading">
                        <div>
                            <span class="eyebrow">NUMUNE KAYITLARI</span>
                            <h2>Tüm numuneler</h2>
                            <p id="sample-summary">Kayıtlar yükleniyor...</p>
                        </div>
                        <div class="panel-actions">
                            <button id="export-samples-csv" class="button button-secondary" type="button" title="Mevcut listeyi CSV olarak indir">📥 CSV İndir</button>
                            <button id="refresh-button" class="button button-secondary" type="button">Listeyi yenile</button>
                            <button id="header-new-sample" class="button button-primary" type="button">+ Yeni numune</button>
                        </div>
                    </div>

                    <div class="table-tools">
                        <label class="search-field">
                            <span aria-hidden="true">⌕</span>
                            <input id="sample-search" type="search" placeholder="Kod, tür, konum veya kullanıcı ara" aria-label="Numunelerde ara" />
                        </label>
                        <label class="filter-field">
                            <span>Durum</span>
                            <select id="status-filter" aria-label="Duruma göre filtrele">
                                <option value="">Tüm durumlar</option>
                                <option value="Created">Kayıt açıldı</option>
                                <option value="Collected">Toplandı</option>
                                <option value="Transferred">Transferde</option>
                                <option value="Received">Kabul edildi</option>
                                <option value="Analyzing">Analizde</option>
                                <option value="Completed">Tamamlandı</option>
                            </select>
                        </label>
                    </div>

                    <div class="table-wrap">
                        <table>
                            <thead><tr><th>Numune</th><th>Tür</th><th>Konum</th><th>Durum</th><th>Oluşturan</th><th>Güncellendi</th><th></th></tr></thead>
                            <tbody id="sample-table"></tbody>
                        </table>
                    </div>
                    <div class="pagination">
                        <button id="previous-page" class="button button-secondary" type="button">← Önceki</button>
                        <span id="page-info">1 / 1</span>
                        <button id="next-page" class="button button-secondary" type="button">Sonraki →</button>
                    </div>
                </article>
            </section>

            <section id="analysis-catalog-view" class="app-view" hidden>
                <article class="panel catalog-panel">
                    <div class="panel-header inline">
                        <div>
                            <span class="eyebrow">ANALİZ KATALOĞU</span>
                            <h2>Analiz kodları ve parametreleri</h2>
                            <p>Numunelere atanabilen aktif analizleri ayrı bir çalışma alanında incele.</p>
                        </div>
                        <button id="refresh-analysis-catalog" class="button button-secondary" type="button">Kataloğu yenile</button>
                    </div>
                    <p id="analysis-catalog-message" class="form-message" aria-live="polite"></p>
                    <div class="catalog-layout">
                        <div id="analysis-catalog-list" class="catalog-list" aria-label="Analiz kodları"></div>
                        <section id="analysis-catalog-detail" class="catalog-detail" aria-live="polite">
                            <div class="catalog-empty">
                                <strong>Bir analiz kodu seç</strong>
                                <p>Parametreleri, birimi ve referans aralığını burada göreceksin.</p>
                            </div>
                        </section>
                    </div>
                </article>
            </section>

            <section id="knowledge-base-view" class="app-view" hidden>
                <article class="panel knowledge-base-panel">
                    <div class="panel-header inline">
                        <div>
                            <span class="eyebrow">YÖNETİCİ RAG ALANI</span>
                            <h2>Bilgi havuzu</h2>
                            <p>Metin belgelerini vektörle, analiz kodlarına bağla ve RAG aramasının seçtiği kaynakları incele.</p>
                        </div>
                        <button id="refresh-knowledge-base" class="button button-secondary" type="button">Listeyi yenile</button>
                    </div>

                    <p id="knowledge-base-message" class="form-message" aria-live="polite"></p>

                    <div class="knowledge-base-layout">
                        <section class="knowledge-base-card">
                            <span class="eyebrow">BELGE EKLE</span>
                            <h3>Metin tabanlı RAG belgesi</h3>
                            <form id="knowledge-document-form" class="form-grid">
                                <label class="wide">Belge başlığı<input name="title" maxlength="200" required /></label>
                                <label>Kategori
                                    <select name="category" required>
                                        <option value="Procedure">Prosedür</option>
                                        <option value="AnalysisMethod">Analiz yöntemi</option>
                                        <option value="QualityGuideline">Kalite kılavuzu</option>
                                    </select>
                                </label>
                                <label>Kaynak durumu
                                    <select id="knowledge-source-status" name="sourceStatus" required>
                                        <option value="Draft">Draft · demo / taslak</option>
                                        <option value="Verified">Verified · doğrulanmış</option>
                                    </select>
                                </label>
                                <label class="wide">Kaynak referansı<input id="knowledge-source-reference" name="sourceReference" maxlength="500" placeholder="Örn. LAB-SOP-014 veya kurum prosedür adı" /></label>
                                <label>Kaynak sürümü<input name="sourceVersion" maxlength="80" placeholder="Örn. Rev. 03" /></label>
                                <label class="wide">Bağlı analiz kodları
                                    <span id="knowledge-analysis-code-options" class="knowledge-code-options">Analiz kodları yükleniyor...</span>
                                </label>
                                <label class="wide">Belge metni<textarea name="sourceText" minlength="30" maxlength="50000" required placeholder="Belge metnini buraya ekle. Draft içeriklerin resmî prosedür olmadığını açıkça belirt."></textarea></label>
                                <div class="form-actions wide">
                                    <button id="submit-knowledge-document" class="button button-primary" type="submit">Belgeyi vektörle ve kaydet</button>
                                </div>
                            </form>
                        </section>

                        <section class="knowledge-base-card">
                            <span class="eyebrow">RAG TESTİ</span>
                            <h3>Vektör arama sonucu</h3>
                            <form id="knowledge-search-form" class="knowledge-search-form">
                                <label>Arama metni<input name="query" minlength="3" maxlength="500" required placeholder="Örn. atık su KOİ sonucu ve kalite kontrol" /></label>
                                <button id="submit-knowledge-search" class="button button-secondary" type="submit">RAG ara</button>
                            </form>
                            <p class="knowledge-help">Bu alan, AI raporundan önce pgvector’ın seçtiği chunk’ları gösterir.</p>
                            <div id="knowledge-search-results" class="knowledge-search-results" aria-live="polite">
                                <p>Bir arama yaparak seçilen kaynak parçalarını inceleyebilirsin.</p>
                            </div>
                        </section>
                    </div>

                    <section class="knowledge-document-list-section">
                        <div class="section-heading">
                            <div>
                                <span class="eyebrow">VEKTÖR KAYITLARI</span>
                                <h3>Kayıtlı belgeler</h3>
                            </div>
                            <span id="knowledge-document-count" class="transition-hint">0 belge</span>
                        </div>
                        <div id="knowledge-document-list" class="knowledge-document-list" aria-live="polite"></div>
                    </section>

                    <dialog id="knowledge-document-dialog" class="knowledge-document-dialog">
                        <article class="knowledge-document-dialog-card">
                            <div class="knowledge-document-dialog-header">
                                <div>
                                    <span class="eyebrow">BELGE DETAYI</span>
                                    <h3 id="knowledge-detail-heading">Bilgi havuzu belgesi</h3>
                                </div>
                                <button id="close-knowledge-document-dialog" class="dialog-close" type="button" aria-label="Belge detayını kapat">&times;</button>
                            </div>
                            <div class="knowledge-detail-summary">
                                <span id="knowledge-detail-source-status" class="knowledge-status draft">Draft</span>
                                <small id="knowledge-detail-metadata"></small>
                            </div>
                            <p id="knowledge-document-detail-message" class="form-message" aria-live="polite"></p>
                            <form id="knowledge-document-detail-form" class="form-grid">
                                <label class="wide">Belge başlığı<input name="title" maxlength="200" required /></label>
                                <label>Kategori
                                    <select name="category" required>
                                        <option value="Procedure">Prosedür</option>
                                        <option value="AnalysisMethod">Analiz yöntemi</option>
                                        <option value="QualityGuideline">Kalite kılavuzu</option>
                                    </select>
                                </label>
                                <label>Kaynak sürümü<input name="sourceVersion" maxlength="80" placeholder="Örn. Rev. 03" /></label>
                                <label class="wide">Kaynak referansı<input name="sourceReference" maxlength="500" /></label>
                                <label class="wide">Bağlı analiz kodları
                                    <span id="knowledge-detail-analysis-code-options" class="knowledge-code-options"></span>
                                </label>
                                <label class="wide">Belge metni<textarea name="sourceText" minlength="30" maxlength="50000" required></textarea></label>
                                <p id="knowledge-detail-edit-note" class="knowledge-help wide"></p>
                                <div class="form-actions wide">
                                    <button id="cancel-knowledge-document-detail" class="button button-secondary" type="button">Kapat</button>
                                    <button id="save-knowledge-document" class="button button-primary" type="submit">Kaydet ve yeniden vektörle</button>
                                </div>
                            </form>
                        </article>
                    </dialog>
                </article>
            </section>

            <section id="users-view" class="app-view" hidden>
                <article class="panel users-panel">
                    <div class="panel-header inline samples-heading">
                        <div>
                            <span class="eyebrow">KULLANICI YÖNETİMİ</span>
                            <h2>Hesaplar ve yetkiler</h2>
                            <p id="user-summary">Kullanıcılar yükleniyor...</p>
                        </div>
                        <button id="show-create-user" class="button button-primary" type="button">+ Yeni kullanıcı</button>
                    </div>

                    <div class="table-tools user-table-tools">
                        <label class="search-field">
                            <span aria-hidden="true">⌕</span>
                            <input id="user-search" type="search" placeholder="Ad, kullanıcı adı veya e-posta ara" aria-label="Kullanıcılarda ara" />
                        </label>
                        <label class="filter-field">
                            <span>Rol</span>
                            <select id="user-role-filter" aria-label="Role göre filtrele">
                                <option value="">Tüm roller</option>
                                <option value="Admin">Yönetici</option>
                                <option value="Laboratory">Laboratuvar çalışanı</option>
                                <option value="Field">Saha çalışanı</option>
                                <option value="Manager">Birim yöneticisi</option>
                            </select>
                        </label>
                        <label class="filter-field">
                            <span>Durum</span>
                            <select id="user-active-filter" aria-label="Aktifliğe göre filtrele">
                                <option value="">Tümü</option>
                                <option value="true">Aktif</option>
                                <option value="false">Onay bekliyor / pasif</option>
                            </select>
                        </label>
                    </div>

                    <div class="table-wrap">
                        <table>
                            <thead><tr><th>Kullanıcı</th><th>E-posta</th><th>Rol</th><th>Durum</th><th>Oluşturuldu</th><th></th></tr></thead>
                            <tbody id="user-table"></tbody>
                        </table>
                    </div>
                    <div class="pagination">
                        <button id="user-previous-page" class="button button-secondary" type="button">← Önceki</button>
                        <span id="user-page-info">1 / 1</span>
                        <button id="user-next-page" class="button button-secondary" type="button">Sonraki →</button>
                    </div>
                </article>
            </section>

            <section id="sample-detail-view" class="app-view sample-detail-view" hidden>
                <article class="sample-detail-shell">
                    <header class="workspace-detail-header">
                        <div>
                            <span class="eyebrow">NUMUNE DETAYI</span>
                            <h2 id="sample-detail-title">Numune bilgileri</h2>
                            <p id="detail-code"></p>
                        </div>
                        <button id="back-to-samples-button" class="button button-secondary" type="button">← Numunelere dön</button>
                    </header>

                    <nav class="detail-tabs" aria-label="Numune detay bölümleri">
                        <button class="detail-tab active" type="button" data-sample-tab="sample-tab-overview" aria-selected="true">Bilgiler ve işlem</button>
                        <button class="detail-tab" type="button" data-sample-tab="sample-tab-analyses" aria-selected="false">Analizler</button>
                        <button class="detail-tab" type="button" data-sample-tab="sample-tab-history" aria-selected="false">Geçmiş</button>
                    </nav>

                    <div id="sample-tab-overview" class="detail-layout detail-tab-panel">
                        <section>
                            <dl class="detail-grid">
                                <div><dt>Numune türü</dt><dd id="detail-sample-type"></dd></div>
                                <div><dt>Güncel durum</dt><dd id="detail-status"></dd></div>
                                <div><dt>Konum</dt><dd id="detail-location"></dd></div>
                                <div><dt>Oluşturan</dt><dd id="detail-created-by"></dd></div>
                                <div><dt>Sorumlu laboratuvar çalışanı</dt><dd id="detail-laboratory-worker"></dd></div>
                                <div><dt>Oluşturulma</dt><dd id="detail-created-at"></dd></div>
                                <div><dt>Son güncelleme</dt><dd id="detail-updated-at"></dd></div>
                                <div class="wide"><dt>Açıklama</dt><dd id="detail-description"></dd></div>
                            </dl>

                            <div class="sample-action-grid" aria-label="Numune işlemleri">
                                <article id="sample-edit-card" class="sample-action-card">
                                    <span class="eyebrow">KAYIT BİLGİLERİ</span>
                                    <h3>Numune bilgilerini düzenle</h3>
                                    <p>Tür, konum ve açıklama alanlarını güncelle.</p>
                                    <button id="show-sample-edit" class="button button-secondary" type="button">Bilgileri düzenle</button>
                                </article>

                                <article id="laboratory-worker-assignment-card" class="sample-action-card" hidden>
                                    <span class="eyebrow">GÖREVLENDİRME</span>
                                    <h3>Laboratuvar çalışanı ata</h3>
                                    <p>Numunenin sorumlu laboratuvar çalışanını belirle.</p>
                                    <button id="show-laboratory-worker-assignment" class="button button-secondary" type="button">Atamayı yönet</button>
                                </article>

                                <article class="sample-action-card">
