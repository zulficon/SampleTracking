                    <p>Kayıt, iş akışına <strong>Kayıt açıldı</strong> aşamasında dahil edilir.</p>
                </div>
                <button id="close-new-sample-button" class="icon-button modal-close" type="button" aria-label="Kapat">×</button>
            </header>

            <form id="new-sample-form" class="form-grid">
                <label>Numune kodu<input name="sampleCode" placeholder="Örn. NUM-2026-033" maxlength="50" autofocus required /></label>
                <label>Numune türü<select name="sampleType" required><option value="">Tür seç</option><option>Kaya</option><option>Toprak</option><option>Cevher</option></select></label>
                <label class="wide">Konum<select id="location-id" name="locationId"><option value="">Konum seçilmedi</option></select></label>
                <label class="wide">Açıklama<textarea name="description" placeholder="Numuneyle ilgili kısa bir açıklama yaz."></textarea></label>
                <p id="new-sample-message" class="form-message wide" aria-live="polite"></p>
                <div class="form-actions wide">
                    <button id="cancel-new-sample" class="button button-secondary" type="button">Vazgeç</button>
                    <button class="button button-primary" type="submit">Numuneyi kaydet</button>
                </div>
            </form>
        </article>
    </section>



    <!-- Global Command Palette (Ctrl + K) -->
    <section id="command-palette" class="modal-layer command-palette-layer" role="dialog" aria-modal="true" aria-label="Komut Paleti" hidden>
        <button id="command-palette-backdrop" class="modal-backdrop" type="button" aria-label="Komut paletini kapat"></button>
        <article class="command-palette-card">
            <div class="command-palette-header">
                <span class="command-search-icon" aria-hidden="true">🔍</span>
                <input id="command-palette-input" class="command-palette-input" type="text" placeholder="Numune ara, sayfaya git veya işlem yap..." autocomplete="off" spellcheck="false" />
                <kbd class="command-palette-esc">ESC</kbd>
            </div>
            <div id="command-palette-results" class="command-palette-results">
                <!-- Dynamically populated categories & actions -->
            </div>
            <div class="command-palette-footer">
                <span class="palette-hint"><kbd>↑</kbd><kbd>↓</kbd> Gezin</span>
                <span class="palette-hint"><kbd>↵</kbd> Seç</span>
                <span class="palette-hint"><kbd>ESC</kbd> Kapat</span>
            </div>
        </article>
    </section>

    <div id="toast" class="toast" role="status" aria-live="polite" hidden></div>
</main>
